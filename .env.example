# Copiá este archivo a infra/.env y completá con tus valores.
# docker compose lee infra/.env automáticamente (no hace falta exportar nada a mano).

# Tu usuario u organización de GitHub — de ahí salen las imágenes:
#   ghcr.io/<GHCR_OWNER>/artagram-backend
#   ghcr.io/<GHCR_OWNER>/artagram-frontend
# (las publica el workflow de cada repo, ver backend/.github/workflows y frontend/.github/workflows)
GHCR_OWNER=tu-usuario-de-github

# Opcional: fijar una versión concreta en vez de "latest" (por ejemplo el SHA de un commit)
# BACKEND_TAG=latest
# FRONTEND_TAG=latest

# Secretos — cambiá estos antes de exponer el stack fuera de tu máquina
JWT_SECRET=dev-only-secret-change-me-please-please-change-32bytes
MEDIA_SIGNING_SECRET=dev-only-media-secret-change-me

# Inteligencia Artificial (Groq Cloud)
GROQ_API_KEY=tu-clave-groq-aqui

# Si el backend queda en un puerto distinto a 8080 (por ejemplo porque ya tenés
# algo corriendo ahí), estas tres tienen que apuntar todas al mismo puerto nuevo:
# BACKEND_PORT=8081
# APP_API_BASE_URL=http://localhost:8081
# VITE_API_BASE_URL=http://localhost:8081
# VITE_WS_URL=ws://localhost:8081/ws
